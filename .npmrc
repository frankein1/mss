shamefully-hoist=true
engine-strict=true

# Only packages released at least 15 days ago can be installed
minimum-release-age=21600

# Install fails if a package's trust level has decreased compared to previous releases
trust-policy=no-downgrade
# To preserve older versions, after 6 months of package age the trust policy is removed
trust-policy-ignore-after=432000

# Only direct dependencies listed in your root package.json may use exotic sources (like git repositories or direct tarball URLs)
block-exotic-sub-deps=true