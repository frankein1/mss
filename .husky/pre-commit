PRECOMMIT_SCRIPT=scripts/custom-pre-commit.sh
if [ -e "$PRECOMMIT_SCRIPT" ]; then
    . "$PRECOMMIT_SCRIPT"
    exit $?
fi

pnpm lint-staged || exit $?

if ! command -v talisman >/dev/null 2>&1; then
    echo "talisman is not installed"
    echo "Install: mkdir -p \$HOME/.talisman && INSTALL_LOCATION=\$HOME/.talisman bash -c \"\$(curl --silent https://raw.githubusercontent.com/thoughtworks/talisman/main/install.sh)\""
    echo "Then: export PATH=\"\$HOME/.talisman:\$PATH\""
    exit 1
fi

talisman --githook pre-commit
