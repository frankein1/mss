{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "github>nuxt/renovate-config-nuxt"],
  "docker-compose": {
    "enabled": false
  },
  "dockerfile": {
    "enabled": false
  },
  "ignoreDeps": ["pnpm", "h3", "html-to-image", "@nuxt/test-utils"],
  "packageRules": [
    {
      "groupName": "Playwright",
      "matchPackagePatterns": ["@playwright/test"]
    },
    {
      "groupName": "dsfr",
      "matchPackagePatterns": [
        "@gouvfr/dsfr",
        "vue-dsfr",
        "vue-dsfr-nuxt-module"
      ]
    },
    {
      "groupName": "vue-tsc",
      "matchPackagePatterns": ["vue-tsc"]
    },
    {
      "groupName": "tRPC",
      "matchPackagePatterns": ["@trpc/client", "@trpc/server", "trpc-nuxt"]
    },
    {
      "groupName": "vee-validate",
      "matchPackagePatterns": [
        "vee-validate",
        "@vee-validate/zod",
        "@vee-validate/nuxt"
      ]
    }
  ],
  "timezone": "Europe/Paris",
  "schedule": ["* * * * 0,1,6"],
  "updateNotScheduled": false,
  "prConcurrentLimit": 5
}
