{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>nuxt/renovate-config-nuxt", "schedule:daily"],
  "docker-compose": {
    "enabled": false
  },
  "dockerfile": {
    "enabled": false
  },
  "ignoreDeps": ["pnpm", "h3", "html-to-image", "@nuxt/test-utils"],
  "packageRules": [
    {
      "groupName": "Playwright",
      "matchPackageNames": ["/@playwright/test/", "/@axe-core/playwright/"]
    },
    {
      "groupName": "dsfr",
      "matchPackageNames": [
        "/@gouvfr/dsfr/",
        "/vue-dsfr/",
        "/vue-dsfr-nuxt-module/"
      ]
    },
    {
      "groupName": "vue-tsc",
      "matchPackageNames": ["/vue-tsc/"]
    },
    {
      "groupName": "tRPC",
      "matchPackageNames": ["/@trpc/client/", "/@trpc/server/", "/trpc-nuxt/"]
    },
    {
      "groupName": "vee-validate",
      "matchPackageNames": [
        "/vee-validate/",
        "/@vee-validate/zod/",
        "/@vee-validate/nuxt/"
      ]
    },
    {
      "groupName": "nuxt-dev",
      "matchPackageNames": ["/@nuxt/eslint/", "/@nuxt/test-utils/"]
    }
  ],
  "timezone": "Europe/Paris",
  "updateNotScheduled": false,
  "prConcurrentLimit": 5
}
