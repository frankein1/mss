{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "github>nuxt/renovate-config-nuxt"],
  "docker-compose": {
    "enabled": false
  },
  "dockerfile": {
    "enabled": false
  },
  "ignoreDeps": ["pnpm", "h3", "typescript"],
  "timezone": "Europe/Paris",
  "schedule": ["* * * * 0,6"],
  "updateNotScheduled": false,
  "prConcurrentLimit": 5
}
