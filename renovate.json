{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>nuxt/renovate-config-nuxt"],
  "docker-compose": {
    "enabled": false
  },
  "dockerfile": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": false,
    "recreateWhen": "never"
  },
  "minimumReleaseAge": "15 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "timezone": "Europe/Paris",
  "updateNotScheduled": false,
  "prConcurrentLimit": 5,
  "ignoreDeps": ["pnpm", "html-to-image"],
  "packageRules": [
    {
      "groupName": "nuxt",
      "description": "nuxt and @nuxt/kit must be bumped together and stay on the exact same version, otherwise two copies of @nuxt/kit end up in the lockfile. Versions are pinned exactly (no caret) because the minimumReleaseAge policy in pnpm-workspace.yaml makes pnpm install fail on a too-recent version that a caret range would resolve to.",
      "matchPackageNames": ["nuxt", "@nuxt/kit"],
      "rangeStrategy": "pin"
    },
    {
      "groupName": "Playwright",
      "matchPackageNames": ["/@playwright/test/", "/@axe-core/playwright/"]
    },
    {
      "groupName": "dsfr",
      "matchPackageNames": [
        "/@gouvfr/dsfr/",
        "/vue-dsfr/",
        "/vue-dsfr-nuxt-module/"
      ]
    },
    {
      "groupName": "vue-tsc",
      "matchPackageNames": ["/vue-tsc/"]
    },
    {
      "groupName": "tRPC",
      "matchPackageNames": [
        "/@trpc/client/",
        "/@trpc/server/",
        "/trpc-nuxt/",
        "/superjson/"
      ]
    },
    {
      "groupName": "vee-validate",
      "matchPackageNames": [
        "/vee-validate/",
        "/@vee-validate/zod/",
        "/@vee-validate/nuxt/"
      ]
    },
    {
      "groupName": "nuxt-dev",
      "matchPackageNames": ["/@nuxt/eslint/", "/@nuxt/test-utils/"]
    },
    {
      "groupName": "tiptap",
      "matchPackageNames": ["/@tiptap/.*/", "/prosemirror-model/"]
    }
  ]
}
