generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "views", "relationJoins"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator erd {
  provider    = "prisma-erd-generator"
  output      = "../docs/database-model.svg"
  ignoreEnums = true
}

model Account {
  id                String  @id @default(uuid()) // FIXME: Cannot set as @db.Uuid as no cast is possible
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model ExternalAccount {
  id String @id @default(uuid()) @db.Uuid

  created DateTime @default(now())
  updated DateTime @updatedAt

  userId            String    @map("user_id") @db.Uuid
  provider          String
  providerAccountId String    @map("provider_account_id")
  refreshToken      String?   @map("refresh_token") @db.Text
  accessToken       String?   @map("access_token") @db.Text
  expiresAt         DateTime? @map("expires_at")

  scope        String?
  idToken      String? @map("id_token") @db.Text
  sessionState String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("external_account")
}

enum UserStatus {
  Active
  Disabled
}

enum UserRole {
  Administrator
  StructureManager
  SocialWorker
  Instructor
  ReceptionAgent
  Referent
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  email     String     @unique
  role      UserRole
  status    UserStatus @default(value: Active)

  accounts         Account[]
  externalAccounts ExternalAccount[]

  createdComments Comment[] @relation(name: "created_by")

  aidantConnectAuthorisation Boolean?  @default(false) @map("aidant_connect_authorisation")
  firstAccess                DateTime? @map("first_access")
  lastAccess                 DateTime? @map("last_access")

  authorizationCode         String?   @map("authorization_code")
  authorizationCodeValidity DateTime? @map("authorization_code_validity")

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  structure   Structure? @relation(fields: [structureId], references: [id])
  structureId String?    @map("structure_id") @db.Uuid

  externalRdvspId String? @map("external_rdvsp_id")

  createdSocialSupports        SocialSupport[]        @relation(name: "created_social_supports")
  lastUpdatedSocialSupports    SocialSupport[]        @relation(name: "last_updated_social_supports")
  createdDocuments             Document[]
  createdSocialSupportSubjects SocialSupportSubject[]
  receivedNotifications        Notification[]         @relation(name: "received_notifications")
  itemCreatedByNotifications   Notification[]         @relation(name: "item_created_by_notifications")

  createdBeneficiaries       Beneficiary[]         @relation(name: "created_beneficiaries")
  disabledBeneficiaries      Beneficiary[]         @relation(name: "disabled_beneficiaries")
  referentFor                FamilyFile[]          @relation(name: "family_file_referents")
  splitFromFileBeneficiaries Beneficiary[]         @relation(name: "split_from_file_beneficiaries")
  archivedBeneficiaries2     ArchivedBeneficiary[] @relation(name: "archived_beneficiaries_2")

  createdPartnerOrganizations PartnerOrganization[]

  accountReminderEmail Int? @default(0) @map("account_reminder_email")

  CGUHistory     CGUHistory[]
  userActivities UserActivity[]
  WorkshopName   WorkshopName[]
  Workshop       Workshop[]

  @@map("user")
}

enum StructureType {
  Ccas
  Cias
  Commune
  Association
  Ministere
}

model Structure {
  id                    String                 @id @default(uuid()) @db.Uuid
  type                  StructureType
  name                  String
  zipcode               String
  city                  String
  address               String
  phone                 String
  email                 String
  inhabitantsNumber     String?                @map("inhabitants_number")
  inseeCode             String?                @map("insee_code")
  siret                 String?
  dpoFirstName          String?                @map("dpo_first_name")
  dpoLastName           String?                @map("dpo_last_name")
  dpoEmail              String?                @map("dpo_email")
  socialSupportSubjects SocialSupportSubject[]
  users                 User[]
  socialSupports        SocialSupport[]
  partnerOrganizations  PartnerOrganization[]

  familyFiles   FamilyFile[]
  beneficiaries Beneficiary[]
  notifications Notification[]

  created                    DateTime?      @default(now())
  updated                    DateTime?      @updatedAt
  userActivities             UserActivity[]
  lastActivity               DateTime?      @map("last_activity")
  lastAccess                 DateTime?      @map("last_access")
  disabled                   Boolean        @default(false)
  deactivationAlertEmail     Int            @default(0) @map("deactivation_alert_email")
  deactivationAlertEmailDate DateTime?      @map("deactivation_alert_email_date")

  externalRdvspActive Boolean? @map("external_rdvsp_active")
  externalRdvspId     String?  @map("external_rdvsp_id")

  archivedBeneficiaries ArchivedBeneficiary[]
  Workshop              Workshop[]
  WorkshopName          WorkshopName[]

  @@map("structure")
}

enum DocumentType {
  Cerfa
  HistoriqueCourrier
  Justificatifs
  Rapports
}

model Document {
  key              String       @id @default(uuid()) // FIXME: Cannot set as @db.Uuid as no cast is possible
  mimeType         String       @map("mime_type")
  name             String
  filenameDisk     String       @map("filename_disk")
  filenameDownload String?      @map("filename_download")
  type             DocumentType
  // Size in bytes
  size             Int?
  tags             String[]
  confidential     Boolean

  familyFile   FamilyFile @relation(fields: [familyFileId], references: [id], onDelete: Cascade)
  familyFileId String     @map("family_file_id") @db.Uuid

  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  beneficiaryId String      @map("beneficiary_id") @db.Uuid

  created        DateTime?       @default(now())
  expirationDate DateTime?       @map("expiration_date") @db.Date
  createdBy      User            @relation(fields: [createdById], references: [id])
  createdById    String          @map("created_by_id") @db.Uuid
  socialSupports SocialSupport[] @relation("document_to_social_support")
  notifications  Notification[]

  migrated Boolean @default(false)

  documentContent DocumentContent?

  @@map("document")
}

model DocumentContent {
  id String @id @default(uuid())

  documentKey String   @map("document_key")
  document    Document @relation(fields: [documentKey], references: [key], onDelete: Cascade)

  content Bytes

  @@unique([documentKey])
  @@map("document_content")
}

enum DefaultSocialSupportSubject {
  // Aide chauffage
  AideChauffage
  // Aide aux impayés d'énergie et fluides
  AideImpayesEnergieFluides
  // Aide médicale d'État - AME
  AideMedicaleDEtat
  // Aide sociale
  AideSociale
  // Allocation de solidarité aux personnes âgées
  AllocationDeSolidariteAuxPersonnesAgees
  // Allocation personnalisées d'autonomie
  AllocationPersonnaliseesDAutonomie
  // Complémentaire santé solidaire
  ComplementaireSanteSolidaire
  // Demande d'aides ménagères
  DemandeDAidesMenageres
  // Domiciliation
  Domiciliation
  // Dossier FSL
  DossierFSL
  // Entrée en établissement pour personnes handicapées
  EntreeEnEtablissementPourPersonnesHandicapees
  // Entrée en famille d'accueil
  EntreeEnFamilleDAccueil
  // Entrée en hébergement pour personnes âgées
  EntreeEnHebergementPourPersonnesAgees
  // Obligation alimentaire
  ObligationAlimentaire
  // PUMA
  Puma
  // Revenu de solidarité active - RSA
  RevenuDeSolidariteActive
  // Accompagnement social
  AccompagnementSocial
  // Aide alimentaire
  AideAlimentaire
  // Aide au transport
  AideAuTransport
  // Animations familles
  AnimationsFamilles
  // Animations seniors
  AnimationsSeniors
  // CAP
  CAP
  // Inclusion numérique
  InclusionNumerique
  // Plan alerte et protection des personnes
  PlanAlerteEtUrgence
  // Soutien administratif
  SoutienAdministratif
  // Soutien à la création d'activité
  SoutienCreationActivite

  @@map("DefaultFollowupType")
}

model SocialSupportSubject {
  id       String                       @id @default(uuid()) @db.Uuid
  name     String
  default  DefaultSocialSupportSubject?
  used     Boolean                      @default(false)
  inactive Boolean                      @default(false)

  created     DateTime? @default(now())
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdById String?   @map("created_by_id") @db.Uuid

  socialSupports SocialSupport[] @relation("social_support_to_followup_type")
  helpRequests   HelpRequest[]

  ownedByStructure   Structure @relation(fields: [ownedByStructureId], references: [id], onDelete: Cascade)
  ownedByStructureId String    @map("owned_by_structured_id") @db.Uuid // FIXME: owned_by_structure**d**_id

  @@unique([ownedByStructureId, name])
  // The following syntax (index + include) is not supported by Prisma yet
  // The index was created manually in 20251111175315_fix_broken_index_on_followup_type
  // @@index([id], include: [name])
  @@map("followup_type")
}

enum SocialSupportStatus {
  // Help request status
  WaitingAdditionalInformation
  InvestigationOngoing
  Accepted
  Refused
  Adjourned
  ClosedByBeneficiary
  ClosedByAgent
  Dismissed

  // Followup status
  Todo
  InProgress
  Done

  // Appointment status
  RdvSeen
  RdvNoShow
  RdvExcused
  RdvRevoked
  RdvUnknown
  RdvDraft
}

enum SocialSupportType {
  Followup
  HelpRequestHousing
  HelpRequest
  Appointment
}

model SocialSupport {
  id String @id @default(uuid()) @db.Uuid

  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  structureId String    @map("structure_id") @db.Uuid

  familyFile   FamilyFile @relation(fields: [familyFileId], references: [id], onDelete: Cascade)
  familyFileId String     @map("family_file_id") @db.Uuid

  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  beneficiaryId String      @map("beneficiary_id") @db.Uuid

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(name: "created_social_supports", fields: [createdById], references: [id])

  lastUpdatedById String? @map("last_updated_by_id") @db.Uuid
  lastUpdatedBy   User?   @relation(name: "last_updated_social_supports", fields: [lastUpdatedById], references: [id])

  subjects SocialSupportSubject[] @relation("social_support_to_followup_type")

  date DateTime @default(now())

  documents     Document[]     @relation("document_to_social_support")
  comments      Comment[]
  notifications Notification[]

  synthesis        String?
  privateSynthesis String? @map("private_synthesis")

  synthesisRichText        String? @map("synthesis_rich_text")
  privateSynthesisRichText String? @map("private_synthesis_rich_text")

  ministre   Minister?
  minister   MinisterEntity? @relation(fields: [ministerId], references: [id])
  ministerId String?         @map("minister_id") @db.Uuid

  numeroPegase String? @map("numero_pegase")

  status  SocialSupportStatus
  dueDate DateTime?           @map("due_date") @db.Date

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  socialSupportType SocialSupportType @map("social_support_type")
  // subtype is equals to followup.medium | fileInstruction.type | appointment.subject
  // depending on the type of SocialSupport
  subtype           String?

  followup                  Followup?
  fileInstruction           FileInstruction?
  socialSupportRedirections SocialSupportRedirection[]

  @@index(fields: [structureId, familyFileId], map: "social_support_structure_id_family_file_id_idx")
  @@index(fields: [beneficiaryId], map: "social_support_beneficiary_id_idx")
  @@map("social_support")
}

model SocialSupportRedirection {
  id                    String                       @id @default(uuid()) @db.Uuid
  type                  SocialSupportRedirectionType
  motif                 String?
  externalStructureName String?                      @map("external_structure_name")

  partnerOrganizationId String?              @map("partner_organization_id") @db.Uuid
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id])

  partnerOrganizationContactId String?                     @map("partner_organization_contact_id") @db.Uuid
  partnerOrganizationContact   PartnerOrganizationContact? @relation(fields: [partnerOrganizationContactId], references: [id])

  socialSupportId String        @map("social_support_id") @db.Uuid
  socialSupport   SocialSupport @relation(fields: [socialSupportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") // for UI purpose only: sort by date

  @@map("social_support_redirection")
}

enum SocialSupportRedirectionType {
  PartnerOrganization
  Intern
  Other
}

enum FollowupMedium {
  // Accueil physique sur rendez-vous
  PlannedInPerson
  // Accueil physique spontané
  UnplannedInPerson
  // Échange téléphonique
  PhoneCall
  // Rendez-vous à domicile
  BeneficiaryHouseAppointment
  // Rendez-vous extérieur
  ExternalAppointment
  // Courrier
  PostalMail
  // E-mail
  Email
  // Visioconférence
  Videoconference
  // Entretien avec un tiers
  ThirdParty
}

enum FollowupDuration {
  Quarter
  Half
  ThreeQuarter
  Hour
  MoreThanHour
}

model Followup {
  id      String    @id @default(uuid()) @db.Uuid
  updated DateTime? @updatedAt

  prescribingOrganizationId String?              @map("prescribing_organization_id") @db.Uuid
  prescribingOrganization   PartnerOrganization? @relation("followup_prescribing_organization", fields: [prescribingOrganizationId], references: [id])

  prescribingOrganizationContactId String?                     @map("prescribing_organization_contact_id") @db.Uuid
  prescribingOrganizationContact   PartnerOrganizationContact? @relation("followup_prescribing_organization_contact", fields: [prescribingOrganizationContactId], references: [id])

  medium FollowupMedium

  helpRequested      Boolean?          @map("help_requested")
  place              String?
  structureName      String?           @map("structure_name")
  thirdPersonName    String?           @map("third_person_name")
  classified         Boolean?
  firstFollowup      Boolean?          @map("first_followup")
  forwardedToJustice Boolean?          @map("forwarded_to_justice")
  redirected         Boolean?
  duration           FollowupDuration?

  socialSupportId String        @unique @map("social_support_id") @db.Uuid
  socialSupport   SocialSupport @relation(fields: [socialSupportId], references: [id], onDelete: Cascade)

  @@map("followup")
}

enum FileInstructionRefusalReason {
  ResourcesOutOfScale
  ShortDeadline
  IncompleteFile
  IrregularSituation
  InadequateFamilyComposition
  ExpiredRequest
  MissedAppointment
  AlreadyExistingHelpRequest
  Reoriented
  Debt
  Other
}

enum FileInstructionType {
  Financial
  Housing
  Other
}

model FileInstruction {
  id      String    @id @default(uuid()) @db.Uuid
  updated DateTime? @updatedAt

  type FileInstructionType @map("type")

  instructorOrganizationId String?              @map("instructor_organization_id") @db.Uuid
  instructorOrganization   PartnerOrganization? @relation("file_instruction_instructor_organization", fields: [instructorOrganizationId], references: [id])

  instructorOrganizationContactId String?                     @map("instructor_organization_contact_id") @db.Uuid
  instructorOrganizationContact   PartnerOrganizationContact? @relation("file_instruction_instructor_organization_contact", fields: [instructorOrganizationContactId], references: [id])

  externalStructure Boolean   @map("external_structure")
  examinationDate   DateTime? @map("examination_date") @db.Date
  decisionDate      DateTime? @map("decision_date") @db.Date

  refusalReason      FileInstructionRefusalReason? @map("refusal_reason")
  refusalReasonOther String?                       @map("refusal_reason_other")
  dispatchDate       DateTime?                     @map("dispatch_date") @db.Date

  fullFile Boolean? @map("full_file")

  socialSupportId String        @unique @map("social_support_id") @db.Uuid
  socialSupport   SocialSupport @relation(fields: [socialSupportId], references: [id], onDelete: Cascade)

  helpRequest        HelpRequest?
  housingHelpRequest HousingHelpRequest?

  @@map("file_instruction")
}

enum PaymentMethod {
  // Virement
  WireTransfer
  // Carte bancaire
  CreditCard
  // Espèces
  Cash
  // Chèque
  Check
  // Bons alimentaire
  FoodStamps
}

model HelpRequest {
  id String @id @default(uuid()) @db.Uuid

  subject   SocialSupportSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String               @map("type_id") @db.Uuid

  prescribingOrganizationId String?              @map("prescribing_organization_id") @db.Uuid
  prescribingOrganization   PartnerOrganization? @relation("help_request_prescribing_organization", fields: [prescribingOrganizationId], references: [id])

  prescribingOrganizationContactId String?                     @map("prescribing_organization_contact_id") @db.Uuid
  prescribingOrganizationContact   PartnerOrganizationContact? @relation("help_request_prescribing_organization_contact", fields: [prescribingOrganizationContactId], references: [id])

  financialSupport Boolean  @map("financial_support")
  isRefundable     Boolean? @map("is_refundable")
  askedAmount      Decimal? @map("asked_amount")
  allocatedAmount  Decimal? @map("allocated_amount")

  paymentMethod PaymentMethod? @map("payment_method")
  paymentDate   DateTime?      @map("payment_date") @db.Date
  handlingDate  DateTime?      @map("handling_date") @db.Date

  fileInstructionId String          @unique @map("file_instruction_id") @db.Uuid
  fileInstruction   FileInstruction @relation(fields: [fileInstructionId], references: [id], onDelete: Cascade)

  @@map("help_request")
}

