model FollowupType {
  id              String               @id @default(uuid()) @db.Uuid
  name            String
  legallyRequired Boolean              @map("legally_required")
  default         DefaultFollowupType?
  legacyId        String?              @map("legacy_id") @db.Uuid // FIXME: What is the purpose of this ?
  used            Boolean              @default(false)

  created     DateTime? @default(now())
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdById String?   @map("created_by_id") @db.Uuid

  socialSupports SocialSupport[] @relation("social_support_to_followup_type")
  helpRequests   HelpRequest[]

  ownedByStructure   Structure @relation(fields: [ownedByStructureId], references: [id], onDelete: Cascade)
  ownedByStructureId String    @map("owned_by_structured_id") @db.Uuid // FIXME: owned_by_structure**d**_id

  @@unique([name, ownedByStructureId])
  @@map("followup_type")
}

enum SocialSupportStatus {
  // Help request status
  WaitingAdditionalInformation
  InvestigationOngoing
  Accepted
  Refused
  Adjourned
  ClosedByBeneficiary
  ClosedByAgent
  Dismissed

  // Followup status
  Todo
  InProgress
  Done
}

enum SocialSupportType {
  Followup
  HelpRequestHousing
  HelpRequest
}

model SocialSupport {
  id String @id @default(uuid()) @db.Uuid

  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  structureId String    @map("structure_id") @db.Uuid

  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  beneficiaryId String      @map("beneficiary_id") @db.Uuid

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(name: "created_social_supports", fields: [createdById], references: [id])

  types FollowupType[] @relation("social_support_to_followup_type")

  date DateTime @default(now()) @db.Date

  documents     Document[]     @relation("document_to_social_support")
  comments      Comment[]
  notifications Notification[]

  synthesis        String?
  privateSynthesis String? @map("private_synthesis")

  ministre     Minister?
  numeroPegase String?   @map("numero_pegase")

  status  SocialSupportStatus
  dueDate DateTime?           @map("due_date") @db.Date

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  socialSupportType SocialSupportType @map("social_support_type")

  followup        Followup?
  fileInstruction FileInstruction?

  @@map("social_support")
}

enum FollowupMedium {
  // Accueil physique sur rendez-vous
  PlannedInPerson
  // Accueil physique spontané
  UnplannedInPerson
  // Échange téléphonique
  PhoneCall
  // Rendez-vous à domicile
  BeneficiaryHouseAppointment
  // Rendez-vous extérieur
  ExternalAppointment
  // Courrier
  PostalMail
  // E-mail
  Email
  // Visioconférence
  Videoconference
  // Entretien avec un tiers
  ThirdParty
}

enum FollowupIntervention {
  DeetsSiao
  Prefecture
  Bailleur
  ActionLogement
  SecoursMedecinTraitant
}

enum FollowupSignalement {
  ChefCabinet
  Prefet
  OrganismeMenace
}

model Followup {
  id      String    @id @default(uuid()) @db.Uuid
  updated DateTime? @updatedAt

  prescribingOrganizationId String?              @map("prescribing_organization_id") @db.Uuid
  prescribingOrganization   PartnerOrganization? @relation("followup_prescribing_organization", fields: [prescribingOrganizationId], references: [id])

  medium FollowupMedium

  helpRequested      Boolean? @map("help_requested")
  place              String?
  structureName      String?  @map("structure_name")
  thirdPersonName    String?  @map("third_person_name")
  classified         Boolean?
  firstFollowup      Boolean? @map("first_followup")
  forwardedToJustice Boolean? @map("forwarded_to_justice")
  redirected         Boolean?

  interventions FollowupIntervention[]
  signalements  FollowupSignalement[]

  socialSupportId String        @unique @map("social_support_id") @db.Uuid
  socialSupport   SocialSupport @relation(fields: [socialSupportId], references: [id], onDelete: Cascade)

  @@map("followup")
}

enum FileInstructionRefusalReason {
  ResourcesOutOfScale
  ShortDeadline
  IncompleteFile
  IrregularSituation
  InadequateFamilyComposition
  ExpiredRequest
  MissedAppointment
  AlreadyExistingHelpRequest
  Reoriented
  Debt
  Other
}

enum FileInstructionType {
  Financial
  Housing
  Other
}

model FileInstruction {
  id      String    @id @default(uuid()) @db.Uuid
  updated DateTime? @updatedAt

  type FileInstructionType @map("type")

  prescribingOrganizationId String?              @map("prescribing_organization_id") @db.Uuid
  prescribingOrganization   PartnerOrganization? @relation("file_instruction_prescribing_organization", fields: [prescribingOrganizationId], references: [id])

  instructorOrganizationId String?              @map("instructor_organization_id") @db.Uuid
  instructorOrganization   PartnerOrganization? @relation("file_instruction_instructor_organization", fields: [instructorOrganizationId], references: [id])

  externalStructure Boolean   @map("external_structure")
  examinationDate   DateTime? @map("examination_date") @db.Date
  decisionDate      DateTime? @map("decision_date") @db.Date

  refusalReason      FileInstructionRefusalReason? @map("refusal_reason")
  refusalReasonOther String?                       @map("refusal_reason_other")
  dispatchDate       DateTime?                     @map("dispatch_date") @db.Date

  fullFile Boolean? @map("full_file")

  socialSupportId String        @unique @map("social_support_id") @db.Uuid
  socialSupport   SocialSupport @relation(fields: [socialSupportId], references: [id], onDelete: Cascade)

  helpRequest        HelpRequest?
  housingHelpRequest HousingHelpRequest?

  @@map("file_instruction")
}

enum PaymentMethod {
  // Virement
  WireTransfer
  // Carte bancaire
  CreditCard
  // Espèces
  Cash
  // Chèque
  Check
  // Bons alimentaire
  FoodStamps
}

model HelpRequest {
  id String @id @default(uuid()) @db.Uuid

  type   FollowupType @relation(fields: [typeId], references: [id])
  typeId String       @map("type_id") @db.Uuid

  financialSupport Boolean  @map("financial_support")
  isRefundable     Boolean? @map("is_refundable")
  askedAmount      Decimal? @map("asked_amount")
  allocatedAmount  Decimal? @map("allocated_amount")

  paymentMethod PaymentMethod? @map("payment_method")
  paymentDate   DateTime?      @map("payment_date") @db.Date
  handlingDate  DateTime?      @map("handling_date") @db.Date

  fileInstructionId String          @unique @map("file_instruction_id") @db.Uuid
  fileInstruction   FileInstruction @relation(fields: [fileInstructionId], references: [id], onDelete: Cascade)

  @@map("help_request")
}

