model Budget {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  legacyMainIncomeSource              String?  @map("legacy_main_income_source")
  legacyMainIncomeAmount              Decimal? @map("legacy_main_income_amount")
  legacyPartnerMainIncomeSource       String?  @map("legacy_partner_main_income_source")
  legacyPartnerMainIncomeAmount       Decimal? @map("legacy_partner_main_income_amount")
  legacyMajorChildrenMainIncomeSource String?  @map("legacy_major_children_main_income_source")
  legacyMajorChildrenMainIncomeAmount Decimal? @map("legacy_major_children_main_income_amount")
  legacyOtherMembersMainIncomeSource  String?  @map("legacy_other_members_main_income_source")
  legacyOtherMembersMainIncomeAmount  Decimal? @map("legacy_other_members_main_income_amount")

  legacyRemainingAfterExpenses Decimal? @map("legacy_remaining_after_expenses")
  numberHouseholdMembers       Decimal? @map("number_household_members")
  savings                      Decimal?
  overdraft                    Decimal?
  familyQuotient               Decimal? @map("family_quotient")
  banqueDeFrance               Decimal? @map("banque_de_france")

  familyFileId String     @unique @map("family_file_id") @db.Uuid
  familyFile   FamilyFile @relation(fields: [familyFileId], references: [id], onDelete: Cascade)

  incomes  BudgetIncome[]
  expenses BudgetExpenses?

  @@map("budget")
}

model Beneficiary {
  id String @id @default(uuid()) @db.Uuid

  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  structureId String    @map("structure_id") @db.Uuid

  familyFile   FamilyFile @relation(name: "beneficiaries", fields: [familyFileId], references: [id], onDelete: Cascade)
  familyFileId String     @map("family_file_id") @db.Uuid

  previousFamilyFile   FamilyFile? @relation(name: "previous_beneficiaries", fields: [previousFamilyFileId], references: [id])
  previousFamilyFileId String?     @map("previous_family_file_id") @db.Uuid

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation(name: "created_beneficiaries", fields: [createdById], references: [id])

