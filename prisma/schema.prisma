  splitFromFileById String? @map("split_from_file_by_id") @db.Uuid

  aidantConnectAuthorized Boolean @default(false) @map("aidant_connect_authorized")

  // General information
  fileNumber                         String                        @unique @map("file_number")
  status                             BeneficiaryStatus
  title                              BeneficiaryTitle?
  usualName                          String?                       @map("usual_name")
  usualNameNormalized                String?                       @default(dbgenerated("lower(immutable_unaccent(usual_name))")) @map("usual_name_normalized")
  birthName                          String?                       @map("birth_name")
  birthNameNormalized                String?                       @default(dbgenerated("lower(immutable_unaccent(birth_name))")) @map("birth_name_normalized")
  firstName                          String?                       @map("first_name")
  firstNameNormalized                String?                       @default(dbgenerated("lower(immutable_unaccent(first_name))")) @map("first_name_normalized")
  birthDate                          DateTime?                     @map("birth_date") @db.Date
  birthPlace                         String?                       @map("birth_place")
  deathDate                          DateTime?                     @map("death_date") @db.Date
  gender                             Gender?
  nationality                        Nationality?
  accommodationMode                  BeneficiaryAccommodationMode? @map("accommodation_mode")
  accommodationName                  String?                       @map("accommodation_name")
  accommodationAdditionalInformation String?                       @map("accommodation_additional_information")
  street                             String?
  addressComplement                  String?                       @map("address_complement")
  zipcode                            String?
  city                               String?
  department                         String?
  region                             String?
  qpv                                Boolean?                      @default(false)
  noPhone                            Boolean                       @default(false) @map("no_phone")
  phone1                             String?
  phone2                             String?
  email                              String?
  familySituation                    BeneficiaryFamilySituation?   @map("family_situation")
  weddingDate                        DateTime?                     @map("wedding_date") @db.Date
  divorceDate                        DateTime?                     @map("divorce_date") @db.Date
  caregiver                          Boolean                       @default(false)
  minorChildren                      Int?                          @map("minor_children")
  majorChildren                      Int?                          @map("major_children")
  mobility                           BeneficiaryMobility?
  vulnerablePerson                   Boolean                       @default(false) @map("vulnerable_person")
  relationship                       RelativeRelationship?

  ministereCategorie            BeneficiaryMinistereCategorie?            @map("ministere_categorie")
  ministereDepartementServiceAc BeneficiaryMinistereDepartementServiceAc? @map("ministere_departement_service_ac")
  ministereStructure            BeneficiaryMinistereStructure?            @map("ministere_structure")

  // Health
  gir                         BeneficiaryGir?
  doctor                      String?
  healthAdditionalInformation String?         @map("health_additional_information")
  socialSecurityNumber        String?         @map("social_security_number")
  insurance                   String?

  // Occupation
  socioProfessionalCategory BeneficiarySocioProfessionalCategory? @map("socio_professional_category")
  schoolName                String?                               @map("school_name")
  isSchoolInQPV             Boolean                               @default(false) @map("is_school_in_qpv")
  studyLevel                BeneficiaryStudyLevel?                @map("study_level")
  occupation                String?
  employer                  String?
  employerSiret             String?                               @map("employer_siret")
  unemploymentNumber        String?                               @map("unemployment_number")
  pensionOrganisations      BeneficiaryPensionOrganisation[]      @map("pension_organisations")
  otherPensionOrganisations String?                               @map("other_pension_organisations")
  cafNumber                 String?                               @map("caf_number")
  bank                      String?
  funeralContract           String?                               @map("funeral_contract")

  // External Structures
  protectionMeasure    BeneficiaryProtectionMeasure? @map("protection_measure")
  representative       String?
  prescribingStructure String?                       @map("prescribing_structure")
  orientationType      BeneficiaryOrientationType?   @map("orientation_type")
  orientationStructure String?                       @map("orientation_structure")
  serviceProviders     String?                       @map("service_providers")
  involvedPartners     String?                       @map("involved_partners")

  additionalInformation String?                       @map("additional_information")
  numeroPegase          String?                       @map("numero_pegase")
  accommodationZone     BeneficiaryAccommodationZone? @map("accommodation_zone")

  // External integrations
  externalRdvspId String? @map("external_rdvsp_id")

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  // archive due date
  archiveDueDate        DateTime?  @map("archive_due_date") @db.Date
  archiveDueDateHistory DateTime[] @map("archive_due_date_history") @db.Date
  lastActivity          DateTime?  @map("last_activity")

  relatives      BeneficiaryRelative[] @relation("ownerBeneficiary")
  // linkedRelatives BeneficiaryRelative[] @relation("linkedBeneficiary")
  socialSupports SocialSupport[]
  documents      Document[]
  notifications  Notification[]

  income BudgetIncome?

  workshopAttendees WorkshopAttendee[]

  // Commented in this schema because Prisma does not support special indexes
  // Applied in 20250508143349_add_normalized_beneficiary_name_fields
  //@@index([structureId(ops: raw("")), usualNameNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "beneficiary_structure_id_usual_name_normalized_idx")
  //@@index([structureId(ops: raw("")), birthNameNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "beneficiary_structure_id_birth_name_normalized_idx")
  //@@index([structureId(ops: raw("")), firstNameNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "beneficiary_structure_id_first_name_normalized_idx")
  @@index(fields: [structureId], map: "beneficiary_structure_id_idx")
  @@index(fields: [familyFileId], map: "beneficiary_family_file_id_idx")
  @@index(fields: [structureId, familyFileId], map: "beneficiary_structure_id_family_file_id_idx")
  @@index(fields: [structureId, fileNumber], map: "beneficiary_structure_id_file_number_idx")
  @@map("beneficiary")
}

enum RelativeRelationship {
  //Conjoint
  Conjoint
  //Enfant mineur
  EnfantMineur
  //Enfant majeur
  EnfantMajeur
  //Parent
  Parent
  //Grand-parent
  Grandparent
  //Voisin
  Neighbour
  //Fratrie
  Sibling
  //Tiers
  Tiers
  //Autre membre de la famille
  AutreMemberDeLaFamille
  //Entourage professionnel
  EntourageProfessionnel
  //Ami
  Ami
}

model BeneficiaryRelative {
  id           String                @id @default(uuid()) @db.Uuid
  lastName     String?               @map("last_name")
  firstName    String?               @map("first_name")
  relationship RelativeRelationship?

  city  String?
  email String?
  phone String?

  hosted    Boolean @default(false)
  caregiver Boolean @default(false)

  beneficiaryId String      @map("beneficiary_id") @db.Uuid
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], name: "ownerBeneficiary", onDelete: Cascade)

  linkedBeneficiaryId String? @map("beneficiary_link_id") @db.Uuid
  // linkedBeneficiary   Beneficiary? @relation(fields: [linkedBeneficiaryId], references: [id], name: "linkedBeneficiary")

  additionalInformation String? @map("additional_information")

  birthDate DateTime? @map("birth_date") @db.Date

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  @@map("beneficiary_relative")
}

model ArchivedBeneficiary {
  id           String    @id @default(uuid()) @db.Uuid
  created      DateTime? @default(now())
  archivedBy   User      @relation(name: "archived_beneficiaries_2", fields: [archivedById], references: [id])
  archivedById String    @map("archived_by_id") @db.Uuid
  structureId  String    @map("structure_id") @db.Uuid
  structure    Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  updated      DateTime? @updatedAt

  title     BeneficiaryTitle?
  usualName String?           @map("usual_name")
  birthName String?           @map("birth_name")
  firstName String?           @map("first_name")

  reason          ArchiveReason?
  eventDateReason DateTime?      @map("event_date_reason")
  clarification   String?

  oldBeneficiaryId      String         @map("old_beneficiary_id") @db.Uuid
  fileCreationDate      DateTime?      @map("file_creation_date")
  socialSupportSubjects String[]
  followupCount         Int?           @map("followup_count")
  filleInstructionCount Int?           @map("file_instruction_count")
  structureType         StructureType? @map("structure_type")

  @@map("archived_beneficiary")
}

enum ArchiveReason {
  NoActivity
  EndOfFollowup
  Reorientation
  Death
  Displacement
  Transfer
  NotPresent
  Other
}

model Comment {
  id String @id @default(uuid()) @db.Uuid

  created     DateTime? @default(now())
  createdBy   User      @relation(name: "created_by", fields: [createdById], references: [id])
  createdById String    @map("created_by_id") @db.Uuid

  updated DateTime?

  content String

  socialSupport   SocialSupport @relation(fields: [socialSupportId], references: [id], onDelete: Cascade)
  socialSupportId String        @map("social_support_id") @db.Uuid

  notification Notification[]

  @@map("comment")
}

model PartnerOrganization {
  id String @id @default(uuid()) @db.Uuid

  created     DateTime? @default(now())
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdById String?   @map("created_by_id") @db.Uuid

  name  String
  siret String?

  address String?
  city    String?
  zipcode String?

  phone1 String?
  phone2 String?
  email  String?

  workingHours String? @map("working_hours")

  inactive Boolean @default(false)

  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  structureId String    @map("structure_id") @db.Uuid

  dataInclusionStructure DataInclusionStructure? @relation(fields: [dataInclusionId], references: [id])
  dataInclusionId        String?                 @map("data_inclusion_id")

  contacts                      PartnerOrganizationContact[]
  followupsPrescribed           Followup[]                   @relation("followup_prescribing_organization")
  fileInstructionsInstructed    FileInstruction[]            @relation("file_instruction_instructor_organization")
  helpRequestsPrescribed        HelpRequest[]                @relation("help_request_prescribing_organization")
  housingHelpRequestsPrescribed HousingHelpRequest[]         @relation("housing_help_request_prescribing_organization")
  workshops                     Workshop[]
  socialSupportRedirections     SocialSupportRedirection[]

  @@unique([structureId, siret])
  @@map("partner_organization")
}

model PartnerOrganizationContact {
  id String @id @default(uuid()) @db.Uuid

  name  String  @map("name")
  phone String? @map("phone")
  email String? @map("email")

  partner   PartnerOrganization @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String              @map("partner_id") @db.Uuid

  followupsPrescribed           Followup[]                 @relation("followup_prescribing_organization_contact")
  fileInstructionsInstructed    FileInstruction[]          @relation("file_instruction_instructor_organization_contact")
  helpRequestsPrescribed        HelpRequest[]              @relation("help_request_prescribing_organization_contact")
  housingHelpRequestsPrescribed HousingHelpRequest[]       @relation("housing_help_request_prescribing_organization_contact")
  socialSupportRedirections     SocialSupportRedirection[]

  @@map("partner_organization_contact")
}

enum NotificationType {
  NewDocument
  DocumentExpirationToday      @map("DocumentExpired")
  DocumentExpirationOneMonth
  NewComment
  DueDateToday                 @map("DueDate")
  DueDateOneMonth
  EndOfSupport
  EndOfSupportOneMonth
  NewFileInstructionElement
  UpdateFileInstructionElement
  NewFollowupElement
  UpdateFollowupElement
  NewSocialSupportSubject
  ArchiveDueToday              @map("ArchiveDue")
  ArchiveDueSevenDays
  ArchiveDueOneMonth
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())

  detail String?

  recipient   User   @relation("received_notifications", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String @map("recipient_id") @db.Uuid

  structure   Structure? @relation(fields: [structureId], references: [id], onDelete: Cascade)
  structureId String?    @map("structure_id") @db.Uuid

  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  beneficiaryId String?      @map("beneficiary_id") @db.Uuid

  socialSupport   SocialSupport? @relation(fields: [socialSupportId], references: [id], onDelete: Cascade)
  socialSupportId String?        @map("social_support_id") @db.Uuid

  itemCreatedBy   User?   @relation("item_created_by_notifications", fields: [itemCreatedById], references: [id])
  itemCreatedById String? @map("item_created_by_id") @db.Uuid

  document   Document? @relation(fields: [documentId], references: [key], onDelete: Cascade)
  documentId String?   @map("document_id")

  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?  @map("comment_id") @db.Uuid

  archiveDate DateTime? @map("archive_date")

  read Boolean? @default(false)

  type NotificationType

  @@map("notification")
}

model CGUHistory {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  date    DateTime @default(now())
  version String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cgu_history")
}

enum UserActivityType {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VIEW
  ARCHIVE
  EXPORT
  IMPORT
}

enum UserActivityObject {
  Comment
  Beneficiary
  ArchivedBeneficiary
  FamilyFile
  Budget
  BudgetExpenses
  BudgetIncome
  HelpRequest
  Followup
  Structure
  Document
  Notification
  User
  Draft
  SocialSupport
  HousingHelpRequest
  PartnerOrganization
  Appointment
  FileInstruction
  SocialSupportSubject
  Workshop
  WorkshopName
  Minister
}

model UserActivity {
  id          String  @id @default(uuid()) @db.Uuid
  key         String?
  userId      String  @map("user_id") @db.Uuid
  structureId String? @map("structure_id") @db.Uuid

  date     DateTime           @default(now())
  object   UserActivityObject
  objectId String             @map("object_id") // FIXME: Should be uuid ?
  activity UserActivityType

  content Json?
  diff    Json?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  structure Structure? @relation(fields: [structureId], references: [id], onDelete: Cascade)

