enum EmailStatus {
  ToSend
  Sending
  Sent
  Error
}

model Email {
  id          String      @id @default(uuid()) @db.Uuid
  from        String
  to          String
  subject     String
  text        String
  html        String
  error       String?
  status      EmailStatus @default(ToSend)
  sentDate    DateTime?
  retryNumber Int         @default(0)

  @@map("email")
}

model DataInclusionStructure {
  id   String @id
  name String

  created DateTime  @default(now())
  updated DateTime?
  version String?

  siret    String?
  rna      String?
  isBranch Boolean @map("is_branch")

  address           String?
  addressComplement String? @map("address_complement")
  city              String?
  zipcode           String?

  phone        String?
  email        String?
  website      String?
  workingHours String? @map("working_hours")

  type   String?
  topics String[]

  PartnerOrganization PartnerOrganization[]

  @@map("data_inclusion_structure")
}

enum JobStatus {
  Created
  Ongoing
  Failure
  Success
}

model JobResult {
  id     String    @id @default(uuid()) @db.Uuid
  name   String
  status JobStatus @default(Created)

  startDate         DateTime  @default(now()) @map("start_date")
  endDate           DateTime? @map("end_date")
  durationInSeconds Decimal?

  errors Json?
  result Json?

  @@map("job_result")
}

model ApiToken {
  id             String   @id @default(uuid()) @db.Uuid
  username       String
  token          String
  expirationDate DateTime @map("expiration_date")

  @@unique([token])
  @@map("api_token")
}

model Workshop {
  id                    String               @id @default(uuid()) @db.Uuid
  workshopName          WorkshopName         @relation(fields: [workshopNameId], references: [id])
  workshopNameId        String               @map("workshop_name_id") @db.Uuid
  structure             Structure            @relation(fields: [structureId], references: [id])
  structureId           String               @map("structure_id") @db.Uuid
  date                  DateTime             @db.Date
  startTime             String?              @map("start_time")
  endTime               String?              @map("end_time")
  location              String?
  partnerOrganizationId String?              @map("partner_organization_id") @db.Uuid
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id])
  host                  String?
  sessionName           String?              @map("session_name")
  description           String?
  attendeeLimit         Int?                 @map("attendee_limit")
  ageLimitCondition     AgeLimitCondition?   @map("ageLimitCondition")
  ageLimit              Int?                 @map("ageLimit")
  chargeable            Boolean              @default(false)
  createdBy             User                 @relation(fields: [createdById], references: [id])
  createdById           String               @map("created_by_id") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at")

  workshopAttendees WorkshopAttendee[]

  @@map("workshop")
}

model WorkshopName {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  structure   Structure  @relation(fields: [structureId], references: [id])
  structureId String     @map("structure_id") @db.Uuid
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdById String     @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_by")
  workshops   Workshop[]

  @@unique([structureId, name])
  @@map("workshop_name")
}

enum AgeLimitCondition {
  GreaterThan
  LowerThan
}

model WorkshopAttendee {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workshopId String   @map("workshop_id") @db.Uuid

  attendance      WorkshopAttendeeAttendance?
  type            WorkshopAttendeeType
  listType        WorkshopAttendeeListType    @map("list_type")
  comment         String?
  paymentReceived Boolean?                    @map("payment_received")
  paymentAmount   Decimal?                    @map("payment_amount")

  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  /// beneficiaryId will be defined if type is 'beneficiary', and null otherwise. Enforced by 'check_attendee_type_and_ids'
  beneficiaryId String?      @map("beneficiary_id") @db.Uuid

  workshopExternalAttendee   WorkshopExternalAttendee? @relation(fields: [workshopExternalAttendeeId], references: [id], onDelete: Cascade)
  /// workshopExternalAttendeeId will be defined if type is not 'beneficiary', and null otherwise. Enforced by 'check_attendee_type_and_ids'
  workshopExternalAttendeeId String?                   @unique @map("workshop_external_attendee_id") @db.Uuid

  // Commented in this schema because Prisma does not support filtered or partial indexes
  // Applied in 20250716075254_workshopattendee_unique_constraint
  // @@unique([workshopId, beneficiaryId],  where: { beneficiaryId: {not: null} })
  @@map("workshop_attendee")
}

enum WorkshopAttendeeAttendance {
  Seen
  NoShow
  Excused
}

enum WorkshopAttendeeType {
  Beneficiary
  External
  Accompanying
}

enum WorkshopAttendeeListType {
  Main
  Waiting
}

model WorkshopExternalAttendee {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  firstName String?   @map("first_name")
  lastName  String?   @map("last_name")
  gender    Gender?
  email     String?
  phone     String?
  birthDate DateTime? @map("birth_date") @db.Date
  city      String?

  isAnonymized Boolean @default(false) @map("is_anonymized")

  workshopAttendee WorkshopAttendee?

  @@map("workshop_external_attendee")
}
