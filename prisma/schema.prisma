enum BudgetIncomeType {
  Beneficiary
  HouseholdMember
}

model BudgetIncome {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  // Travail
  salary        Decimal?
  primeActivite Decimal? @map("prime_activite")

  // Pensions
  retirement Decimal?
  alimony    Decimal?
  disability Decimal?

  // Allocations
  unemployment Decimal?
  ass          Decimal?
  rsa          Decimal?
  apl          Decimal?
  family       Decimal?
  aah          Decimal?
  aspa         Decimal?

  // Autre ressources
  dailyAllowance Decimal? @map("daily_allowance")
  annuity        Decimal?
  other          Decimal?

  // Charges personnalisées
  customs BudgetIncomeCustom[]

  type BudgetIncomeType

  beneficiaryId String?      @unique @map("beneficiary_id") @db.Uuid
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  lastName     String?               @map("last_name")
  firstName    String?               @map("first_name")
  relationship RelativeRelationship?

  budgetId String @map("budget_id") @db.Uuid
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@map("budget_income")
}

model BudgetIncomeCustom {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  type   String?
  amount Decimal? @map("amount")

  incomeId String       @map("income_id") @db.Uuid
  income   BudgetIncome @relation(fields: [incomeId], references: [id], onDelete: Cascade)

  @@map("budget_income_custom")
}

model FamilyFile {
  id String @id @default(uuid()) @db.Uuid

  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  structureId String    @map("structure_id") @db.Uuid

  referents User[] @relation(name: "family_file_referents")

  budget                Budget?
  documents             Document[]
  socialSupports        SocialSupport[]
  beneficiaries         Beneficiary[]   @relation(name: "beneficiaries")
  previousBeneficiaries Beneficiary[]   @relation(name: "previous_beneficiaries")

  @@map("family_file")
}

model BudgetExpenses {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  // Logement
  rent        Decimal?
  expenses    Decimal?
  water       Decimal?
  electricity Decimal?
  gas         Decimal?
  fuelOrOther Decimal? @map("fuel_or_other")

  // Impôts
  housingTax  Decimal? @map("housing_tax")
  propertyTax Decimal? @map("property_tax")
  incomeTax   Decimal? @map("income_tax")

  // Assurances
  carInsurance        Decimal? @map("car_insurance")
  homeInsurance       Decimal? @map("home_insurance")
  deathInsurance      Decimal? @map("death_insurance")
  retirementInsurance Decimal? @map("retirement_insurance")
  otherInsurance      Decimal? @map("other_insurance")

  // Autres charges
  remittedAlimony Decimal? @map("remitted_alimony")
  healthInsurance Decimal? @map("health_insurance")
  phoneInternet   Decimal? @map("phone_internet")
  schoolFees      Decimal? @map("school_fees")
  schoolCanteen   Decimal? @map("school_canteen")
  other           Decimal?

  budgetId String @unique @map("budget_id") @db.Uuid
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  // Crédits et dettes
  loans BudgetExpensesLoan[]
  debts BudgetExpensesDebt[]

  // Charges personnalisées
  customs BudgetExpensesCustom[]

  @@map("budget_expenses")
}

model BudgetExpensesLoan {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  type           String?
  amountTotal    Decimal?  @map("amount_total")
  amountPerMonth Decimal?  @map("amount_per_month")
  dueDate        DateTime? @map("due_date")

  expensesId String         @map("expenses_id") @db.Uuid
  expenses   BudgetExpenses @relation(fields: [expensesId], references: [id], onDelete: Cascade)

  @@map("budget_expenses_loan")
}

model BudgetExpensesDebt {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())
  updated DateTime? @updatedAt

  type           String?
  amountTotal    Decimal?  @map("amount_total")
  amountPerMonth Decimal?  @map("amount_per_month")
  dueDate        DateTime? @map("due_date")

  expensesId String         @map("expenses_id") @db.Uuid
  expenses   BudgetExpenses @relation(fields: [expensesId], references: [id], onDelete: Cascade)

  @@map("budget_expenses_debt")
}

model BudgetExpensesCustom {
  id String @id @default(uuid()) @db.Uuid

  created DateTime? @default(now())
