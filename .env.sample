# ENVIRONMENT
MSS_ENVIRONMENT="local"

# Activate node packages debug
#DEBUG="prisma:client"

# DATABASE URL
DATABASE_URL="postgresql://mss:password@localhost:5433/mss"

# APP URL
APP_URL='http://localhost:3000'
LANDING_PAGE_URL='https://monsuivisocial.dev.incubateur.anct.gouv.fr'

# DISCONNECT_THRESHOLD in minutes
DISCONNECT_THRESHOLD=60
DISCONNECT_ALERT_THRESHOLD=5

# JWT SIGN KEY
TOKEN_VALIDATION_IN_MINUTES=30
AUTH_JWT_KEY=        # Secret for auth token signature
AUTH_SESSION_SECRET= # Secret for Nitro server session encryption

AUTH_PROCONNECT_ISSUER_URL='https://fca.integ01.dev-agentconnect.fr/api/v2'
AUTH_PROCONNECT_CLIENT_ID=xxxxxxxx
AUTH_PROCONNECT_CLIENT_SECRET=xxxxxxxxx
AUTH_PROCONNECT_SIGNING_ALGORITHM=RS256

# EMAIL
EMAIL_FROM=monsuivisocial@local.mss.fr
EMAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false

# S3 STORAGE
S3_ACCESS_KEY_ID=rustfs-mss
S3_SECRET_ACCESS_KEY=rustfs-local-access-key
S3_REGION=fr-par
S3_BUCKET=mon-suivi-social-local-documents
