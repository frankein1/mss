# ENVIRONMENT
NUXT_PUBLIC_MSS_ENVIRONMENT="local"

# Activate node packages debug
#DEBUG="prisma:client"

# DATABASE URL
DATABASE_URL="postgresql://mss:password@localhost:5433/mss"

# APP URL
NUXT_PUBLIC_APP_URL='http://localhost:3000'
NUXT_PUBLIC_LANDING_PAGE_URL='https://monsuivisocial.dev.incubateur.anct.gouv.fr'

# DISCONNECT_THRESHOLD in minutes
DISCONNECT_THRESHOLD=60
DISCONNECT_ALERT_THRESHOLD=5

# JWT SIGN KEY
TOKEN_VALIDATION_IN_MINUTES=30
NUXT_AUTH_JWT_KEY=        # Secret for auth token signature
NUXT_AUTH_SESSION_SECRET= # Secret for Nitro server session encryption

NUXT_AUTH_PROCONNECT_ISSUER_URL='https://fca.integ01.dev-agentconnect.fr/api/v2'
NUXT_AUTH_PROCONNECT_CLIENT_ID=xxxxxxxx
NUXT_AUTH_PROCONNECT_CLIENT_SECRET=xxxxxxxxx
NUXT_AUTH_PROCONNECT_SIGNING_ALGORITHM=RS256

# EMAIL
NUXT_PUBLIC_EMAIL_FROM=monsuivisocial@local.mss.fr
NUXT_EMAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
NUXT_EMAIL_SMTP_USER=
NUXT_EMAIL_SMTP_PASSWORD=
NUXT_EMAIL_SMTP_PORT=587
NUXT_EMAIL_SMTP_SECURE=false

# S3 STORAGE
NUXT_S3_ACCESS_KEY_ID=rustfs-mss
NUXT_S3_SECRET_ACCESS_KEY=rustfs-local-access-key
NUXT_S3_REGION=fr-par
NUXT_S3_BUCKET=mon-suivi-social-local-documents
NUXT_S3_ENDPOINT=http://localhost:9010

# Key Management System
NUXT_KMS_ACCESS_KEY_ID=mockkms-mss
NUXT_KMS_SECRET_KEY=mockkms-local-secret-key
NUXT_KMS_ORGANIZATION_ID=mockkms-organization-id
NUXT_KMS_PROJECT_ID=mockkms-project-id
NUXT_KMS_REGION=fr-par
NUXT_KMS_API_URL=http://localhost:9110
NUXT_KMS_KEY_ID=mockkms-kek-id

# Document encryption
DOCUMENT_USE_ENCRYPTION=true

