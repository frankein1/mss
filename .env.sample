# DATABASE URL
DATABASE_URL="postgresql://mss:password@localhost:5433/mss"

# JWT SIGN KEY
JWT_KEY=secretJWT

# APP URL
APP_URL='http://localhost:3000'

# INACTIVE_USER_TIME_THRESHOLD in minutes
INACTIVE_USER_TIME_THRESHOLD=10

# INCLUSION CONNECT
IC_AUTH_TYPE='keycloak'
IC_PROVIDER='InclusionConnect'
IC_ISSUER='https://recette.connect.inclusion.beta.gouv.fr/realms/local'
IC_CLIENT_ID='local_inclusion_connect'
IC_CLIENT_SECRET='password' # NOTE: Add InclusionConnect local client secret

# DEV ONLY
DB_DATABASE=mss
DB_USER=mss
DB_PASSWORD=password
DB_PORT=5433
DB_HOST=localhost
