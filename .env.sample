NUXT_PUBLIC_METABASE_PUBLIC_URL=http://metabase.monsuivisocial.incubateur.anct.gouv.fr:443/public/dashboard/146613ca-cef1-4cdc-8789-1b5cc6c582d8

# BREVO
NUXT_BREVO_API_KEY=

# RDVSP
NUXT_RDVSP_ISSUER=
NUXT_RDVSP_CLIENT_ID=
NUXT_RDVSP_CLIENT_SECRET=

# DEV ONLY POSTGRES
DB_DATABASE=mss
DB_USER=mss
DB_PASSWORD=password
DB_PORT=5433

# DEV ONLY S3 RUSTFS
S3_PORT=9010
S3_CONSOLE_PORT=9011

# DEV ONLY KMS OPEN BAO
KMS_PORT=9110
KMS_UNSEAL_KEY=  # Generate with `openssl rand -base64 32`

# DATA INCLUSION
NUXT_PUBLIC_DATA_INCLUSION_TOKEN=
