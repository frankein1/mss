EMAIL_SMTP_HOST=smtp-relay.sendinblue.com
EMAIL_SMTP_PASSWORD=xxxxxxx # NOTE: Add SMTP password
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=contactincubateur@anct.gouv.fr

# DEV ONLY
