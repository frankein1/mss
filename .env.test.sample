# ENVIRONMENT
ENVIRONMENT="local"

# Activate node packages debug
#DEBUG="prisma:client"

# DATABASE URL
DATABASE_URL="postgresql://mss:password@localhost:5434/mss"

# APP URL
APP_URL='http://localhost:3111'
PORT=3111

# DISCONNECT_THRESHOLD in minutes
DISCONNECT_THRESHOLD=30
DISCONNECT_ALERT_THRESHOLD=5

# JWT SIGN KEY
TOKEN_VALIDATION_IN_MINUTES=30
AUTH_JWT_KEY=secretJWT

# INCLUSION CONNECT
AUTH_KEYCLOAK_ISSUER_URL='https://recette.connect.inclusion.beta.gouv.fr'
AUTH_KEYCLOAK_CLIENT_ID='demo'
AUTH_KEYCLOAK_CLIENT_SECRET=xxxxxxxxx # NOTE: Add InclusionConnect demo client secret

# EMAIL
