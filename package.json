    "@tiptap/core": "^3.2.0",
    "@tiptap/pm": "^3.2.0",
    "@tiptap/starter-kit": "^3.2.0",
    "@tiptap/vue-3": "^3.2.0",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@vee-validate/nuxt": "^4.15.0",
    "@vee-validate/zod": "^4.15.0",
    "@zip.js/zip.js": "^2.7.72",
    "chart.js": "^4.5.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.8",
    "html-to-image": "1.11.11",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lodash.merge": "^4.6.2",
    "magic-bytes.js": "^1.12.1",
    "mitt": "^3.0.1",
    "node-fetch-native": "^1.6.7",
    "nodemailer": "^7.0.5",
    "nuxt-security": "2.3.0",
    "postcss-html": "^1.8.0",
    "prisma": "^6.14.0",
    "remove-accents": "^0.5.0",
    "superjson": "^2.2.2",
    "trpc-nuxt": "^1.2.0",
    "tsx": "^4.20.4",
    "uuid": "^11.1.0",
    "vee-validate": "^4.15.0",
