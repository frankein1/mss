{
  "name": "monsuivisocial-v2",
  "version": "1.37.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "dev:db:start": "docker compose -f docker-compose.dev.yml up -d",
    "lint:typecheck": "nuxt typecheck",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\"",
    "lint:prettier": "prettier --check {.,**/*.prisma}",
    "lint": "npm run lint:typecheck && npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lintfix": "prettier --write --list-different {.,**/*.prisma} && npm run lint:js -- --fix && npm run lint:style -- --fix",
    "test": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "DISABLE_ERD=true prisma generate && nuxt prepare",
    "prisma": "prisma",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.2.0",
    "@gouvfr/dsfr": "~1.12.1",
    "@gouvminint/vue-dsfr": "^7.1.0",
    "@prisma/client": "^5.22.0",
    "@sentry/vue": "^8.41.0",
    "@tiptap/core": "2.10.3",
    "@tiptap/extension-link": "2.10.3",
    "@tiptap/pm": "2.10.3",
    "@tiptap/starter-kit": "2.10.3",
    "@tiptap/vue-3": "2.10.3",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@vee-validate/nuxt": "^4.14.7",
    "@vee-validate/zod": "^4.14.7",
    "@zip.js/zip.js": "^2.7.53",
    "chart.js": "^4.4.7",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.11",
    "install": "^0.13.0",
    "json-diff": "^1.0.6",
    "jsonwebtoken": "^9.0.2",
    "lodash.merge": "^4.6.2",
    "magic-bytes.js": "^1.10.0",
    "mitt": "^3.0.1",
    "node-fetch-native": "^1.6.4",
    "nodemailer": "^6.9.16",
    "npm": "^10.9.2",
    "nuxt-security": "2.1.5",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.2",
    "postcss-html": "^1.7.0",
    "prisma": "^5.22.0",
    "superjson": "^2.2.1",
    "trpc-nuxt": "^0.10.22",
    "uuid": "^11.0.3",
    "vee-validate": "^4.14.7",
    "vue-matomo": "^4.2.0",
    "vue-scrollto": "^2.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@nuxt/eslint": "^0.7.2",
    "@playwright/test": "^1.49.0",
    "@sentry/node": "^8.41.0",
    "@types/json-diff": "1.0.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.7",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.6",
    "@vueuse/core": "^12.0.0",
    "commit-and-tag-version": "^12.5.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "nuxt": "^3.14.1592",
    "nuxt-scheduler": "^0.1.9",
    "prettier": "3.4.1",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma-erd-generator": "^1.11.2",
    "sass": "^1.81.0",
    "stylelint": "^16.11.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.6",
    "vue-dsfr-nuxt-module": "^2.0.0",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
    "h3": "1.11.1"
  },
  "pnpm": {
    "overrides": {
      "mermaid": "10.9.3",
      "tough-cookie": "4.1.4",
      "ws": "^8.18.0"
    }
  },
  "engines": {
    "pnpm": ">=9 <=9.15.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{css,scss,sass,html,vue}": "stylelint",
    "*.**": "prettier --check {.,**/*.prisma}"
  }
