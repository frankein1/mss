{
  "name": "monsuivisocial-v2",
  "version": "1.46.0",
  "scripts": {
    "dev": "nuxt dev",
    "dev:log": "FORCE_COLOR=1 LOG=prisma,trpc npm run dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "dev:db:start": "docker compose -f docker-compose.dev.yml up -d",
    "lint:typecheck": "nuxt typecheck",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\"",
    "lint:prettier": "prettier --check {.,**/*.prisma}",
    "lint": "npm run lint:typecheck && npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lintfix": "prettier --write --list-different {.,**/*.prisma} && npm run lint:js -- --fix && npm run lint:style -- --fix",
    "test": "TZ=UTC vitest",
    "test:e2e": "playwright test",
    "postinstall": "DISABLE_ERD=true prisma generate && nuxt prepare",
    "prisma": "prisma",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.5.0",
    "@gouvfr/dsfr": "~1.13.2",
    "@gouvminint/vue-dsfr": "^8.4.0",
    "@prisma/client": "^6.11.1",
    "@sentry/vue": "^9.38.0",
    "@tiptap/core": "2.26.1",
    "@tiptap/extension-link": "2.26.1",
    "@tiptap/pm": "2.26.1",
    "@tiptap/starter-kit": "2.26.1",
    "@tiptap/vue-3": "2.26.1",
    "@trpc/client": "^11.4.3",
    "@trpc/server": "^11.4.3",
    "@vee-validate/nuxt": "^4.15.0",
    "@vee-validate/zod": "^4.15.0",
    "@zip.js/zip.js": "^2.7.63",
    "chart.js": "^4.5.0",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.8",
    "html-to-image": "1.11.11",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lodash.merge": "^4.6.2",
    "magic-bytes.js": "^1.12.1",
    "mitt": "^3.0.1",
    "node-fetch-native": "^1.6.6",
    "nodemailer": "^6.10.1",
    "nuxt-security": "2.2.0",
    "postcss-html": "^1.8.0",
    "prisma": "^6.11.1",
    "remove-accents": "^0.5.0",
    "superjson": "^2.2.2",
    "trpc-nuxt": "^1.2.0",
    "uuid": "^11.1.0",
    "vee-validate": "^4.15.0",
    "vue-matomo": "^4.2.0",
    "vue-scrollto": "^2.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@faker-js/faker": "^9.9.0",
    "@nuxt/eslint": "^1.5.2",
    "@nuxt/test-utils": "^3.17.2",
    "@playwright/test": "^1.53.2",
    "@sentry/node": "^9.38.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.16.3",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^13.5.0",
    "commit-and-tag-version": "^12.5.1",
    "dotenv": "^17.2.0",
    "eslint": "^9.31.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nuxt": "^3.16.1",
    "nuxt-scheduler": "^0.1.9",
    "picocolors": "^1.1.1",
    "prettier": "3.6.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma-erd-generator": "^2.0.4",
    "sass": "^1.89.2",
    "stylelint": "^16.21.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4",
    "vue-dsfr-nuxt-module": "^2.0.0",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "h3": "1.11.1"
  },
  "pnpm": {
    "overrides": {
      "tough-cookie": "4.1.4",
      "ws": "^8.18.3"
    }
  },
  "engines": {
    "pnpm": ">=10 <11"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{css,scss,sass,html,vue}": "stylelint",
    "*.**": "prettier --check {.,**/*.prisma}"
  },
  "packageManager": "pnpm@10.13.1"
}
