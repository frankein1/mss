{
  "name": "monsuivisocial-v2",
  "version": "1.32.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "dev:db:start": "docker compose -f docker-compose.dev.yml up -d",
    "lint:typecheck": "nuxt typecheck",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\"",
    "lint:prettier": "prettier --check {.,**/*.prisma}",
    "lint": "npm run lint:typecheck && npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lintfix": "prettier --write --list-different {.,**/*.prisma} && npm run lint:js -- --fix && npm run lint:style -- --fix",
    "test": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "DISABLE_ERD=true prisma generate && nuxt prepare",
    "prisma": "prisma",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.2.0",
    "@gouvfr/dsfr": "~1.12.1",
    "@gouvminint/vue-dsfr": "^7.1.0",
    "@prisma/client": "^5.21.1",
    "@sentry/vue": "^8.36.0",
    "@tiptap/core": "2.9.1",
    "@tiptap/extension-link": "2.9.1",
    "@tiptap/pm": "2.9.1",
    "@tiptap/starter-kit": "2.9.1",
    "@tiptap/vue-3": "2.9.1",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@vee-validate/nuxt": "^4.14.6",
    "@vee-validate/zod": "^4.14.6",
    "chart.js": "^4.4.6",
    "dayjs": "^1.11.13",
    "dom-to-image-more": "^3.5.0",
    "exceljs": "^4.4.0",
    "json-diff": "^1.0.6",
    "jsonwebtoken": "^9.0.2",
    "lodash.merge": "^4.6.2",
    "mitt": "^3.0.1",
    "node-fetch-native": "^1.6.4",
    "nodemailer": "^6.9.16",
    "nuxt-security": "2.0.0",
    "postcss-html": "^1.7.0",
    "prisma": "^5.21.1",
    "superjson": "^2.2.1",
    "trpc-nuxt": "^0.10.22",
    "uuid": "^11.0.2",
    "vee-validate": "^4.14.6",
    "vue-matomo": "^4.2.0",
    "vue-scrollto": "^2.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@nuxt/eslint": "^0.6.1",
    "@playwright/test": "^1.48.2",
    "@sentry/node": "^8.36.0",
    "@types/json-diff": "1.0.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.8.7",
    "@types/nodemailer": "^6.4.16",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.4",
    "@vueuse/core": "^11.2.0",
    "commit-and-tag-version": "^12.5.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "nuxt": "^3.14.0",
    "nuxt-scheduler": "^0.1.9",
    "prettier": "3.3.3",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma-erd-generator": "^1.11.2",
    "sass": "^1.80.6",
    "stylelint": "^16.10.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.4",
    "vue-dsfr-nuxt-module": "^2.0.0",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
    "h3": "1.11.1"
  },
  "pnpm": {
    "overrides": {
      "mermaid": "10.9.3",
      "tough-cookie": "4.1.4",
      "ws": "^8.18.0"
    }
  },
  "engines": {
    "pnpm": ">=8.6.2 <=9.12.1"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{css,scss,sass,html,vue}": "stylelint",
    "*.**": "prettier --check {.,**/*.prisma}"
  }
}
