{
  "name": "monsuivisocial-v2",
  "version": "1.59.3",
  "scripts": {
    "dev": "nuxt dev",
    "dev:log": "FORCE_COLOR=1 LOG=prisma,trpc,rdvsp pnpm run dev",
    "dev:scheduler": "tsx watch scheduler/index.ts",
    "build": "pnpm build:nuxt && pnpm build:scheduler",
    "build:nuxt": "nuxt build",
    "build:scheduler": "tsdown --no-config scheduler/index.ts --out-dir .output-scheduler && tsdown --no-config scheduler/_caller.ts --out-dir .output-scheduler_caller",
    "start": "nuxt start",
    "start:scheduler": "node .output-scheduler/index.mjs",
    "generate": "nuxt generate",
    "dev:db:start": "docker compose -f docker-compose.dev.yml up -d",
    "lint:typecheck": "nuxt typecheck",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\"",
    "lint:prettier": "prettier --check {.,**/*.prisma}",
    "lint": "pnpm run /^lint:.*/",
    "lintfix": "prettier --write --list-different {.,**/*.prisma} && pnpm run lint:js -- --fix && pnpm run lint:style -- --fix",
    "test": "TZ=UTC vitest",
    "test:e2e": "playwright test",
    "postinstall": "DISABLE_ERD=true prisma generate && nuxt prepare",
    "prisma": "prisma",
    "release": "commit-and-tag-version",
    "prepare": "husky",
    "scheduler:archive-notifications": "tsx server/scheduler/notifications/archive-notifications.ts",
    "scheduler:archive-reminders-notifications": "tsx server/scheduler/notifications/archive-reminders-notifications.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/lib-storage": "^3.1019.0",
    "@braintree/sanitize-url": "^7.1.2",
    "@gouvfr/dsfr": "~1.14.1",
    "@gouvminint/vue-dsfr": "^8.8.0",
    "@prisma/client": "^6.19.3",
    "@scaleway/sdk": "^3.2.1",
    "@sentry/node": "^10.46.0",
    "@sentry/vue": "^10.46.0",
    "@tiptap/core": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "@tiptap/vue-3": "^3.21.0",
    "@trpc/client": "^11.12.0",
    "@trpc/server": "^11.12.0",
    "@vee-validate/nuxt": "^4.15.0",
    "@vee-validate/zod": "^4.15.0",
    "@zip.js/zip.js": "^2.7.72",
    "chart.js": "^4.5.0",
    "croner": "^9.0.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "html-to-image": "1.11.11",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "jwks-rsa": "^3.2.2",
    "lodash.merge": "^4.6.2",
    "magic-bytes.js": "^1.12.1",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.11",
    "node-fetch-native": "^1.6.7",
    "nodemailer": "^7.0.13",
    "nuxt-security": "2.3.0",
    "pg": "^8.16.3",
    "picocolors": "^1.1.1",
    "postcss-html": "^1.8.0",
    "prisma": "^6.19.3",
    "prosemirror-model": "^1.25.4",
    "remove-accents": "^0.5.0",
    "superjson": "^2.2.2",
    "trpc-nuxt": "^2.0.1",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "vee-validate": "^4.15.0",
    "vue-matomo": "^4.2.0",
    "vue-scrollto": "^2.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@faker-js/faker": "^10.0.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/robots": "6.0.9",
    "@playwright/test": "^1.58.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.17.2",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^13.7.0",
    "commit-and-tag-version": "^12.5.2",
    "eslint": "^9.39.4",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "nuxt": "^3.21.4",
    "prettier": "3.6.2",
    "prettier-plugin-prisma": "^5.0.0",
    "sass": "^1.99.0",
    "stylelint": "^17.11.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5",
    "vue-dsfr-nuxt-module": "^2.0.0",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "pnpm": ">=11",
    "node": "^24"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{css,scss,sass,html,vue}": "stylelint  --allow-empty-input",
    "*.**": "prettier --ignore-unknown --check {.,**/*.prisma}"
  },
  "packageManager": "pnpm@11.1.3"
}
