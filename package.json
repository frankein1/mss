    "@axe-core/playwright": "^4.10.2",
    "@faker-js/faker": "^10.0.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^3.19.2",
    "@playwright/test": "^1.55.0",
    "@sentry/node": "^10.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.17.2",
    "@types/nodemailer": "^7.0.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^13.7.0",
    "commit-and-tag-version": "^12.5.2",
    "eslint": "^9.33.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "nuxt": "^3.16.1",
    "nuxt-scheduler": "^0.1.9",
    "picocolors": "^1.1.1",
    "prettier": "3.6.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma-erd-generator": "^2.0.4",
    "sass": "^1.90.0",
    "stylelint": "^16.23.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "vue-dsfr-nuxt-module": "^2.0.0",
    "vue-tsc": "^3.0.6"
  },
  "overrides": {
    "h3": "1.11.1"
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.18.3"
    }
  },
  "engines": {
    "pnpm": ">=10 <11"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{css,scss,sass,html,vue}": "stylelint",
    "*.**": "prettier --check {.,**/*.prisma}"
  },
  "packageManager": "pnpm@10.13.1"
