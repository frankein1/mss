{
  "name": "monsuivisocial-v2",
  "version": "1.18.2",
  "scripts": {
    "dev": "nuxt dev",
    "dev:db:start": "docker compose -f docker-compose.dev.yml up -d",
    "build": "nuxt build",
    "start": "nuxt preview",
    "lint:typecheck": "nuxt typecheck",
    "lint:js": "eslint --ext \".ts,.js,.vue\" --ignore-path .gitignore .",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\"",
    "lint:prettier": "prettier --check {.,**/*.prisma}",
    "lint": "npm run lint:typecheck && npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lintfix": "prettier --write --list-different {.,**/*.prisma} && npm run lint:js -- --fix && npm run lint:style -- --fix",
    "test": "vitest",
    "postinstall": "prisma generate && nuxt prepare",
    "prisma": "prisma",
    "release": "standard-version"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.525.0",
    "@aws-sdk/s3-request-presigner": "^3.525.0",
    "@gouvfr/dsfr": "~1.11.2",
    "@gouvminint/vue-dsfr": "^5.10.3",
    "@prisma/client": "^5.8.1",
    "@sentry/vue": "^7.105.0",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@vee-validate/nuxt": "^4.12.6",
    "@vee-validate/zod": "^4.12.6",
    "@vitest/coverage-v8": "^1.3.1",
    "chart.js": "^4.4.2",
    "dayjs": "^1.11.10",
    "exceljs": "^4.3.0",
    "json-diff": "^1.0.6",
    "jsonwebtoken": "^9.0.2",
    "lodash.merge": "^4.6.2",
    "mitt": "^3.0.1",
    "node-fetch-native": "^1.6.4",
    "nodemailer": "^6.9.13",
    "nuxt-security": "1.1.1",
    "openid-client": "^5.6.5",
    "postcss-html": "^1.6.0",
    "superjson": "^2.2.1",
    "trpc-nuxt": "^0.10.19",
    "uuid": "^9.0.1",
    "vee-validate": "^4.12.6",
    "vue-matomo": "^4.2.0",
    "vue-scrollto": "^2.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@sentry/node": "^7.105.0",
    "@types/json-diff": "1.0.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.8",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "nuxt": "^3.10.1",
    "nuxt-scheduler": "^0.1.9",
    "prettier": "3.2.5",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^5.8.1",
    "sass": "^1.71.1",
    "standard-version": "^9.5.0",
    "stylelint": "^16.2.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3",
    "vitest": "^1.3.1",
    "vue-tsc": "^1.8.27"
  },
  "engines": {
    "pnpm": ">=8.6.2 <9.0.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
