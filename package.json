{
  "name": "monsuivisocial-v2",
  "version": "1.10.0",
  "scripts": {
    "dev": "nuxt dev",
    "dev:db:start": "docker compose -f docker-compose.dev.yml up -d",
    "build": "nuxt build",
    "start": "nuxt preview",
    "lint:typecheck": "nuxt typecheck",
    "lint:js": "eslint --ext \".ts,.js,.vue\" --ignore-path .gitignore .",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\"",
    "lint:prettier": "prettier --check {.,**/*.prisma}",
    "lint": "npm run lint:typecheck && npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lintfix": "prettier --write --list-different {.,**/*.prisma} && npm run lint:js -- --fix && npm run lint:style -- --fix",
    "test": "vitest",
    "postinstall": "prisma generate && nuxt prepare",
    "prisma": "prisma",
    "release": "standard-version"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.429.0",
    "@aws-sdk/s3-request-presigner": "^3.429.0",
    "@gouvfr/dsfr": "~1.10.2",
    "@gouvminint/vue-dsfr": "^5.0.0",
    "@pinia/nuxt": "^0.5.1",
    "@prisma/client": "^5.4.2",
    "@sentry/vue": "^7.74.1",
    "@trpc/client": "^10.40.0",
    "@trpc/server": "^10.40.0",
    "@types/json-diff": "^1.0.2",
    "@vee-validate/nuxt": "^4.11.8",
    "@vee-validate/zod": "^4.11.8",
    "@vitest/coverage-v8": "^0.34.6",
    "chart.js": "^4.4.0",
    "dayjs": "^1.11.10",
    "exceljs": "^4.3.0",
    "json-diff": "^1.0.6",
    "jsonwebtoken": "^9.0.2",
    "mitt": "^3.0.1",
    "node-fetch-native": "^1.4.1",
    "nodemailer": "^6.9.7",
    "nuxt-security": "^0.14.4",
    "openid-client": "^5.6.1",
    "pinia": "^2.1.7",
    "postcss-html": "^1.5.0",
    "superjson": "^2.0.0",
    "trpc-nuxt": "^0.10.12",
    "uuid": "^9.0.1",
    "vee-validate": "^4.11.8",
    "vue-matomo": "^4.2.0",
    "vue-scrollto": "^2.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.8.6",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "nuxt": "^3.7.4",
    "nuxt-scheduler": "^0.0.16",
    "prettier": "3.0.3",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^5.4.2",
    "sass": "^1.69.5",
    "standard-version": "^9.5.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^11.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.2.2",
    "vitest": "^0.34.6",
    "vue-tsc": "^1.8.22"
  },
  "engines": {
    "pnpm": ">=8.6.2 <9.0.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
