    "@sentry/vue": "^9.6.1",
    "@tiptap/core": "2.11.5",
    "@tiptap/extension-link": "2.11.5",
    "@tiptap/pm": "2.11.5",
    "@tiptap/starter-kit": "2.11.5",
    "@tiptap/vue-3": "2.11.5",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@vee-validate/nuxt": "^4.15.0",
    "@vee-validate/zod": "^4.15.0",
    "@zip.js/zip.js": "^2.7.57",
    "chart.js": "^4.4.8",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.8",
    "html-to-image": "1.11.11",
    "json-diff": "^1.0.6",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lodash.merge": "^4.6.2",
    "magic-bytes.js": "^1.10.0",
    "mitt": "^3.0.1",
    "node-fetch-native": "^1.6.6",
    "nodemailer": "^6.10.0",
    "nuxt-security": "2.2.0",
    "postcss-html": "^1.8.0",
    "prisma": "^6.5.0",
    "superjson": "^2.2.2",
    "trpc-nuxt": "^0.10.22",
    "uuid": "^11.1.0",
    "vee-validate": "^4.15.0",
    "vue-matomo": "^4.2.0",
    "vue-scrollto": "^2.20.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@nuxt/eslint": "^1.2.0",
    "@nuxt/test-utils": "^3.17.2",
    "@playwright/test": "^1.51.1",
    "@sentry/node": "^9.6.1",
    "@types/json-diff": "1.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.0.9",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^13.0.0",
    "commit-and-tag-version": "^12.5.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.22.0",
    "happy-dom": "^17.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "nuxt": "^3.16.1",
    "nuxt-scheduler": "^0.1.9",
    "prettier": "3.5.3",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma-erd-generator": "^2.0.4",
    "sass": "^1.86.0",
    "stylelint": "^16.16.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vitest": "^3.0.9",
    "vue-dsfr-nuxt-module": "^2.0.0",
    "vue-tsc": "^2.2.8"
  },
  "overrides": {
    "h3": "1.11.1"
  },
  "pnpm": {
    "overrides": {
      "tough-cookie": "4.1.4",
      "ws": "^8.18.1"
    }
  },
  "engines": {
    "pnpm": ">=9 <=9.15.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{css,scss,sass,html,vue}": "stylelint",
    "*.**": "prettier --check {.,**/*.prisma}"
  }
