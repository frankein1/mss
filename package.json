{
  "name": "monsuivisocial-v2",
  "version": "1.24.3",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "dev:db:start": "docker compose -f docker-compose.dev.yml up -d",
    "lint:typecheck": "nuxt typecheck",
    "lint:js": "eslint --ext \".ts,.js,.vue\" --ignore-path .gitignore .",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\"",
    "lint:prettier": "prettier --check {.,**/*.prisma}",
    "lint": "npm run lint:typecheck && npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lintfix": "prettier --write --list-different {.,**/*.prisma} && npm run lint:js -- --fix && npm run lint:style -- --fix",
    "test": "vitest",
    "postinstall": "DISABLE_ERD=true prisma generate && nuxt prepare",
    "prisma": "prisma",
    "release": "standard-version"
  },
  "dependencies": {
    "@gouvfr/dsfr": "~1.11.2",
    "@gouvminint/vue-dsfr": "^5.17.2",
    "@prisma/client": "^5.14.0",
    "@sentry/vue": "^8.7.0",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@vee-validate/nuxt": "^4.12.8",
    "@vee-validate/zod": "^4.12.8",
    "@vitest/coverage-v8": "^1.6.0",
    "chart.js": "^4.4.3",
    "dayjs": "^1.11.11",
    "exceljs": "^4.4.0",
    "json-diff": "^1.0.6",
    "jsonwebtoken": "^9.0.2",
    "lodash.merge": "^4.6.2",
    "mitt": "^3.0.1",
    "node-fetch-native": "^1.6.4",
    "nodemailer": "^6.9.13",
    "nuxt-security": "1.2.2",
    "openid-client": "^5.6.5",
    "postcss-html": "^1.7.0",
    "prisma": "^5.14.0",
    "superjson": "^2.2.1",
    "trpc-nuxt": "^0.10.21",
    "uuid": "^9.0.1",
    "vee-validate": "^4.12.8",
    "vue-matomo": "^4.2.0",
    "vue-scrollto": "^2.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@sentry/node": "^8.7.0",
    "@types/json-diff": "1.0.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^20.12.13",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^9.0.8",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "nuxt": "^3.11.2",
    "nuxt-scheduler": "^0.1.9",
    "prettier": "3.2.5",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma-erd-generator": "^1.11.2",
    "sass": "^1.77.4",
    "standard-version": "^9.5.0",
    "stylelint": "^16.6.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5",
    "vitest": "^1.6.0",
    "vue-tsc": "^1.8.27"
  },
  "overrides": {
    "h3": "1.11.1"
  },
  "engines": {
    "pnpm": ">=8.6.2 <9.1.4"
  },
