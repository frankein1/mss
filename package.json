{
  "name": "monsuivisocial-v2",
  "version": "1.27.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "dev:db:start": "docker compose -f docker-compose.dev.yml up -d",
    "lint:typecheck": "nuxt typecheck",
    "lint:js": "eslint --ext \".ts,.js,.vue\" --ignore-path .gitignore . --fix",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\"",
    "lint:prettier": "prettier --check {.,**/*.prisma}",
    "lint": "npm run lint:typecheck && npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lintfix": "prettier --write --list-different {.,**/*.prisma} && npm run lint:js -- --fix && npm run lint:style -- --fix",
    "test": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "DISABLE_ERD=true prisma generate && nuxt prepare",
    "prisma": "prisma",
    "release": "standard-version"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.2.0",
    "@gouvfr/dsfr": "~1.12.1",
    "@gouvminint/vue-dsfr": "^5.18.2",
    "@prisma/client": "^5.17.0",
    "@sentry/vue": "^8.18.0",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@vee-validate/nuxt": "^4.13.2",
    "@vee-validate/zod": "^4.13.2",
    "@vitest/coverage-v8": "^2.0.5",
    "chart.js": "^4.4.3",
    "dayjs": "^1.11.12",
    "exceljs": "^4.4.0",
    "json-diff": "^1.0.6",
    "jsonwebtoken": "^9.0.2",
    "lodash.merge": "^4.6.2",
    "mitt": "^3.0.1",
    "node-fetch-native": "^1.6.4",
    "nodemailer": "^6.9.14",
    "nuxt-security": "1.2.2",
    "openid-client": "^5.6.5",
    "postcss-html": "^1.7.0",
    "prisma": "^5.17.0",
    "superjson": "^2.2.1",
    "trpc-nuxt": "^0.10.22",
    "uuid": "^10.0.0",
    "vee-validate": "^4.13.2",
    "vue-matomo": "^4.2.0",
    "vue-scrollto": "^2.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@playwright/test": "^1.45.2",
    "@sentry/node": "^8.18.0",
    "@types/json-diff": "1.0.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^20.14.11",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^10.0.0",
    "@vueuse/core": "^10.11.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "nuxt": "^3.11.2",
    "nuxt-scheduler": "^0.1.9",
    "prettier": "3.3.3",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma-erd-generator": "^1.11.2",
    "sass": "^1.77.8",
    "standard-version": "^9.5.0",
    "stylelint": "^16.7.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.0.29"
  },
  "overrides": {
    "h3": "1.11.1"
  },
  "engines": {
    "pnpm": ">=8.6.2 <=9.1.4"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
