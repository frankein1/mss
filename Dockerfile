# Stage 1: Build
FROM node:24-alpine AS builder
WORKDIR /app

# Enable corepack and install pnpm
RUN corepack enable && corepack prepare pnpm@10.29.2 --activate

# Copy dependency files first for better layer caching
COPY package.json pnpm-lock.yaml ./
COPY prisma/ ./prisma/

# Install dependencies (cached independently of env var changes)
# postinstall hook automatically runs: DISABLE_ERD=true prisma generate && nuxt prepare
RUN pnpm install --frozen-lockfile

# Copy remaining source code
COPY . .

# Build arguments — declared AFTER dependency install so that
# changing an env var does not invalidate the pnpm install layer.
# Public runtimeConfig values are baked into the client bundle at build time,
# so they must be available here. Private runtimeConfig values are set as
# defaults; they can be overridden at container runtime via env_file.
ARG MSS_ENVIRONMENT=local
ARG DATABASE_URL
ARG APP_URL
ARG LANDING_PAGE_URL
ARG DISCONNECT_THRESHOLD=60
ARG DISCONNECT_ALERT_THRESHOLD=5
ARG TOKEN_VALIDATION_IN_MINUTES=60
ARG AUTH_JWT_KEY
ARG AUTH_SESSION_SECRET
ARG AUTH_PROCONNECT_ISSUER_URL
ARG AUTH_PROCONNECT_CLIENT_ID
ARG AUTH_PROCONNECT_CLIENT_SECRET
ARG AUTH_PROCONNECT_SIGNING_ALGORITHM=HS256
ARG EMAIL_FROM
ARG EMAIL_SMTP_HOST
ARG EMAIL_SMTP_USER
ARG EMAIL_SMTP_PASSWORD
ARG EMAIL_SMTP_PORT=587
ARG EMAIL_SMTP_SECURE=false
ARG MATOMO_HOST
ARG MATOMO_SITE_ID
ARG SENTRY_DSN
ARG SENTRY_DEBUG=false
ARG SENTRY_TRACE_SAMPLE_RATE=0.1
ARG METABASE_PUBLIC_URL
ARG BREVO_API_KEY
ARG RDVSP_ISSUER
ARG RDVSP_CLIENT_ID
ARG RDVSP_CLIENT_SECRET

ENV MSS_ENVIRONMENT=${MSS_ENVIRONMENT}
ENV DATABASE_URL=${DATABASE_URL}
ENV APP_URL=${APP_URL}
ENV LANDING_PAGE_URL=${LANDING_PAGE_URL}
ENV DISCONNECT_THRESHOLD=${DISCONNECT_THRESHOLD}
ENV DISCONNECT_ALERT_THRESHOLD=${DISCONNECT_ALERT_THRESHOLD}
ENV TOKEN_VALIDATION_IN_MINUTES=${TOKEN_VALIDATION_IN_MINUTES}
ENV AUTH_JWT_KEY=${AUTH_JWT_KEY}
ENV AUTH_SESSION_SECRET=${AUTH_SESSION_SECRET}
ENV AUTH_PROCONNECT_ISSUER_URL=${AUTH_PROCONNECT_ISSUER_URL}
ENV AUTH_PROCONNECT_CLIENT_ID=${AUTH_PROCONNECT_CLIENT_ID}
ENV AUTH_PROCONNECT_CLIENT_SECRET=${AUTH_PROCONNECT_CLIENT_SECRET}
ENV AUTH_PROCONNECT_SIGNING_ALGORITHM=${AUTH_PROCONNECT_SIGNING_ALGORITHM}
ENV EMAIL_FROM=${EMAIL_FROM}
ENV EMAIL_SMTP_HOST=${EMAIL_SMTP_HOST}
ENV EMAIL_SMTP_USER=${EMAIL_SMTP_USER}
ENV EMAIL_SMTP_PASSWORD=${EMAIL_SMTP_PASSWORD}
ENV EMAIL_SMTP_PORT=${EMAIL_SMTP_PORT}
ENV EMAIL_SMTP_SECURE=${EMAIL_SMTP_SECURE}
ENV MATOMO_HOST=${MATOMO_HOST}
ENV MATOMO_SITE_ID=${MATOMO_SITE_ID}
ENV SENTRY_DSN=${SENTRY_DSN}
ENV SENTRY_DEBUG=${SENTRY_DEBUG}
ENV SENTRY_TRACE_SAMPLE_RATE=${SENTRY_TRACE_SAMPLE_RATE}
ENV METABASE_PUBLIC_URL=${METABASE_PUBLIC_URL}
ENV BREVO_API_KEY=${BREVO_API_KEY}
ENV RDVSP_ISSUER=${RDVSP_ISSUER}
ENV RDVSP_CLIENT_ID=${RDVSP_CLIENT_ID}
ENV RDVSP_CLIENT_SECRET=${RDVSP_CLIENT_SECRET}

# Build only Nuxt (no scheduler)
RUN pnpm build:nuxt


# Stage 2: Production runtime
FROM node:24-alpine AS production
WORKDIR /app

# Set production environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Copy Nuxt build output from builder
COPY --from=builder /app/.output ./.output
COPY --from=builder /app/node_modules ./node_modules

# Expose the port
EXPOSE 3000

# Start the application
CMD ["node", ".output/server/index.mjs"]
