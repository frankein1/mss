{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "~~/*": ["../*"],
      "~/*": ["../app/*"]
    }
  },
  "include": ["**/*"]
}
