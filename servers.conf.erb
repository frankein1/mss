# Node application redirection
upstream node_upstream {
  server unix:/tmp/nginx.sock;
}

server {
  listen <%= ENV['PORT'] %>;
  server_name _;

  # Forward the client IP to nginx process instead of Scalingo Load Balancer IP
  set_real_ip_from 0.0.0.0/0;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  # Blacklist IP blocks from list $BLOCKED_IP_SUBNETS 
  <% if ENV['BLOCKED_IP_SUBNETS'] && !ENV['BLOCKED_IP_SUBNETS'].empty? %>
  <% ENV['BLOCKED_IP_SUBNETS'].split(',').each do |ip| %>
  deny <%= ip.strip %>;
  <% end %>
  allow all;
  <% end %>

  # Deactivate request logs since the scalingo router already prints them
  access_log off;

  # Override max payload size to match limit for document upload
  client_max_body_size 20m;

  location / {
    proxy_pass http://node_upstream;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Scalingo forces https
    proxy_set_header X-Forwarded-Proto https;
  }

  # Custom error page for IP filtering
  # Upstream 403s from node should pass through untouched
  error_page 403 /403.html;

  location = /403.html {
    # Path of the compiled public assets in scalingo container
    root /app/.output/public;
    # Not accessible from http request
    internal;
  }
}