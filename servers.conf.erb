# Node application redirection
upstream node_upstream {
  server unix:/tmp/nginx.sock;
}

server {
  listen <%= ENV['PORT'] %>;
  server_name _;

  # Blacklist IP blocks from list $BLOCKED_IP_SUBNETS
  <% if ENV['BLOCKED_IP_SUBNETS'] && !ENV['BLOCKED_IP_SUBNETS'].empty? %>
  <% ENV['BLOCKED_IP_SUBNETS'].split(',').each do |ip| %>
  deny <%= ip.strip %>;
  <% end %>
  allow all;
  <% end %>

  # Deactivate request logs since the scalingo router already prints them
  access_log off;

  <% if ENV['ENABLE_MODSECURITY'] %>
  modsecurity_rules_file /app/scripts/nginx-geoip-filtering/custom-rules.modsecurity;
  <% if ENV['MODSECURITY_RULE_ENGINE'] == 'DetectionOnly' %>
  modsecurity_rules_file /app/scripts/nginx-geoip-filtering/detection-only.modsecurity;
  <% end %>
  # Geo IP allowlist filter. Gated behind its own env var (not just
  # ENABLE_MODSECURITY) because geo-filter.modsecurity references a GeoIP DB via
  # SecGeoLookupDB — if that file is missing, nginx fails to boot. Only turn on
  # ENABLE_GEO_FILTER once the .mmdb is in the slug. See geo-filter.modsecurity.
  <% if ENV['ENABLE_GEO_FILTER'] %>
  modsecurity_rules_file /app/scripts/nginx-geoip-filtering/geo-filter.modsecurity;
  <% end %>
  <% end %>

  # Override max payload size to match limit for document upload
  # Kept slightly above the 20MB app cap (MAX_UPLOAD_SIZE_BYTES) so the multipart envelope (boundaries +
  # metadata fields) around a genuine 20MB file is not rejected at the boundary.
  client_max_body_size 21m;

  # Common proxy headers, inherited by every proxied location below
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  # Scalingo forces https
  proxy_set_header X-Forwarded-Proto https;

  # Serve immutable, content-hashed build assets directly from disk.
  # Keeps static files off the Node process and out of proxy_temp.
  location /_nuxt/ {
    root /app/.output/public;
    expires 1y;
    add_header Cache-Control "public, immutable";
    access_log off;
  }

  # Document upload/download stream multi-MB bodies. Disable buffering so
  # large responses are streamed straight through instead of spilling to
  # proxy_temp, and request bodies are forwarded without client_body_temp.
  location /api/document/ {
    proxy_pass http://node_upstream;
    proxy_buffering off;
    proxy_request_buffering off;
  }

  location / {
    proxy_pass http://node_upstream;
  }

  # Custom error page for IP filtering
  # Upstream 403s from node should pass through untouched
  error_page 403 /403.html;

  location = /403.html {
    # Path of the compiled public assets in scalingo container
    root /app/.output/public;
    # Not accessible from http request
    internal;
  }
}
